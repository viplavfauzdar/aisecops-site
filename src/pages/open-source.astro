---
import ProseLayout from "../layouts/ProseLayout.astro";
import OpenSourceContent from "../content/open-source.md";

const title = "AISecOps Interceptor - Open Source Runtime Governance Platform for Agentic AI | aisecops.net";
const description = "AISecOps Interceptor is the open-source runtime governance platform for agentic AI: Replay Diff Engine, Agent Identity Layer, Compliance Evidence Export, Risk Explanation Engine, MCP Policy Proxy, and Local Enforcement Mode.";
---
<ProseLayout title={title} description={description}>
<h1>Open Source</h1>
<p>Catalog building blocks, examples, and reusable patterns for the runtime governance platform.</p>
<p class="not-prose cta-wrap">
  <a class="cta-btn" href="https://github.com/viplavfauzdar/aisecops-interceptor" target="_blank" rel="noopener noreferrer">View GitHub</a>
</p>
<OpenSourceContent />
</ProseLayout>

<style>
  .cta-wrap { margin-top: 1.5rem; }
  .cta-btn {
    display: inline-block;
    padding: 0.6rem 1rem;
    border-radius: 3px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .cta-btn:hover { background: #a83d12; }
</style>
