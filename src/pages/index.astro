---
import Seo from "../components/Seo.astro";
import Analytics from "../components/Analytics.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "AISecOps Interceptor v1.0.0 - Runtime Governance Platform for Agentic AI | aisecops.net";
const description = "AISecOps Interceptor is the Runtime Governance Platform for Agentic AI: Security, Compliance, Cost Control, and Observability across plan extraction, capability validation, policy enforcement, runtime budgets, Local Enforcement Mode, MCP Policy Proxy, Replay Diff, and evidence export.";

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "AISecOps",
  url: "https://aisecops.net",
  logo: "https://aisecops.net/logo.svg",
  sameAs: []
};
---
<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} jsonLd={orgJsonLd} />
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta charset="UTF-8" />
  </head>
  <body>
    <Header />

    <section class="hero">
      <div class="hero-bg"></div>
      <div class="hero-grid-overlay"></div>
      <div class="hero-inner">
        <div class="hero-left">
          <div class="hero-kicker">AISecOps · aisecops.net</div>
          <h1 class="hero-h1">
            The Runtime Governance Platform<br />
            for Agentic AI.
          </h1>
          <p class="hero-p">
            AISecOps Interceptor governs agentic AI across Security, Compliance, Cost Control, and
            Observability. It adds plan extraction, capability validation, policy enforcement,
            runtime budgets, Agent Identity, Replay Diff, and Compliance Evidence Export to the execution path.
          </p>
          <div class="hero-actions">
            <a class="btn-primary" href="/runtime-forensics">Explore Runtime Forensics →</a>
            <a class="btn-secondary" href="/open-source">View Open Source →</a>
          </div>
          <div class="release-badge">Current OSS release: v1.0.0 · Replay Diff Engine + Evidence Export</div>
        </div>

        <div class="architecture-card">
          <div class="architecture-head">
            <span class="architecture-kicker">Runtime architecture</span>
            <span class="architecture-headline">Governance sits between planning and execution.</span>
          </div>
          <div class="architecture-flow" aria-label="AISecOps runtime architecture">
            <div class="arch-step">
              <span class="arch-step-label">Agent</span>
            </div>
            <span class="arch-arrow">↓</span>
            <div class="arch-step">
              <span class="arch-step-label">Plan Extraction</span>
            </div>
            <span class="arch-arrow">↓</span>
            <div class="arch-step arch-highlight">
              <span class="arch-step-label">Runtime Governance</span>
              <span class="arch-step-sub">Security · Compliance · Cost Control · Observability</span>
            </div>
            <span class="arch-arrow">↓</span>
            <div class="arch-step">
              <span class="arch-step-label">Tools</span>
            </div>
            <span class="arch-arrow">↓</span>
            <div class="arch-step">
              <span class="arch-step-label">Audit / Replay / Evidence</span>
            </div>
          </div>
          <div class="architecture-foot">Plan extraction, capability validation, policy enforcement, runtime budgets, Agent Identity, Replay Diff, and Evidence Export.</div>
        </div>
      </div>
    </section>

    <div class="trust-bar">
      <div class="trust-inner">
        <span class="trust-label">Framework covers</span>
        <div class="trust-items">
          <span class="trust-item">Security</span>
          <span class="trust-item">Compliance</span>
          <span class="trust-item">Cost Control</span>
          <span class="trust-item">Observability</span>
          <span class="trust-item">Replay Diff</span>
          <span class="trust-item">Evidence Export</span>
          <span class="trust-item">Agent Identity</span>
          <span class="trust-item">MCP Policy Proxy</span>
        </div>
      </div>
    </div>

    <section class="runtime-proof-section">
      <div class="section-inner">
        <div class="section-kicker">Runtime Governance in Action</div>
        <h2 class="section-h2">Implementation proof from the runtime path.</h2>
        <p class="section-sub">
          The architecture above explains the control plane. This runtime trace shows how the platform records, evaluates, and explains a governed execution.
        </p>

        <div class="terminal">
          <div class="terminal-bar">
            <div class="dot dot-r"></div>
            <div class="dot dot-y"></div>
            <div class="dot dot-g"></div>
            <span class="terminal-title">aisecops-runtime · replay.trace</span>
          </div>
          <div class="terminal-body">
            <div class="terminal-line"><span class="t-key">agent_identity_verified</span></div>
            <div class="terminal-line"><span class="t-key">policy allow_with_budget</span></div>
            <div class="terminal-line"><span class="t-key">runtime_budget tracked</span></div>
            <div class="terminal-line"><span class="t-key">replay_diff matched</span></div>
            <div class="terminal-line"><span class="t-key">evidence_export ready</span></div>
            <div class="terminal-line"><span class="t-key">governance_result controlled_execution</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="comparison-section">
      <div class="section-inner">
        <div class="section-kicker">Why Existing Tools Are Not Enough</div>
        <h2 class="section-h2">Prompt guards, observability tools, and gateways do not add up to runtime governance.</h2>
        <p class="section-sub">
          AISecOps combines the runtime controls needed to govern autonomous execution: identity, budgets, policy, replay, evidence, and local enforcement.
        </p>

        <div class="comparison-wrap">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Capability</th>
                <th>Prompt Guards</th>
                <th>Observability Tools</th>
                <th>AI Gateways</th>
                <th class="aisecops-col">AISecOps</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Prompt inspection</td>
                <td><span class="score strong">Strong</span></td>
                <td><span class="score partial">Partial</span></td>
                <td><span class="score partial">Partial</span></td>
                <td><span class="score strong">Strong</span></td>
              </tr>
              <tr>
                <td>Tool governance</td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score partial">Partial</span></td>
                <td><span class="score partial">Partial</span></td>
                <td><span class="score strong">Strong</span></td>
              </tr>
              <tr>
                <td>Runtime budgets</td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score strong">Strong</span></td>
              </tr>
              <tr>
                <td>Agent identity</td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score partial">Partial</span></td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score strong">Strong</span></td>
              </tr>
              <tr>
                <td>Replay diff</td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score strong">Strong</span></td>
                <td><span class="score partial">Partial</span></td>
                <td><span class="score strong">Strong</span></td>
              </tr>
              <tr>
                <td>Evidence export</td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score partial">Partial</span></td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score strong">Strong</span></td>
              </tr>
              <tr>
                <td>Local enforcement</td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score partial">Partial</span></td>
                <td><span class="score strong">Strong</span></td>
              </tr>
              <tr>
                <td>MCP Policy Proxy</td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score weak">Weak</span></td>
                <td><span class="score strong">Strong</span></td>
                <td><span class="score strong">Strong</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section>
      <div class="section-inner">
        <div class="section-kicker">The Problem</div>
        <h2 class="section-h2">Agentic AI changed the operating model.<br />Most teams have not caught up.</h2>
        <p class="section-sub">
          Enterprises are deploying AI agents that browse the web, read email, query databases,
          and execute code. Traditional application security was not designed for governed autonomous
          execution systems with identity, policy, evidence, and cost controls.
        </p>

        <div class="problem-grid">
          <div class="problem-cell">
            <div class="problem-label before">Before AISecOps</div>
            <p>Your AI agent calls a tool. You see a log entry. There is no identity layer, policy engine, evidence package, or Replay Diff to explain what changed, why the action was allowed, or whether it stayed within budget.</p>
          </div>
          <div class="problem-cell">
            <div class="problem-label after">With AISecOps</div>
            <p>Every execution plan passes through a runtime governance platform. Agent Identity, capability gates, policy enforcement, runtime budgets, Replay Diff, and Compliance Evidence Export are all part of the same path. Structured audit logs enable explainability, forensics, and governance.</p>
          </div>
          <div class="problem-cell">
            <div class="problem-label before">What attackers exploit</div>
            <p>Indirect prompt injection via RAG. Tool parameter manipulation. Missing identity. Missing evidence export. Uncontrolled runtime cost. Policy drift as models and prompts evolve. These are not theoretical and have been demonstrated in production agentic systems.</p>
          </div>
          <div class="problem-cell">
            <div class="problem-label after">What this framework provides</div>
              <p>A layered runtime governance architecture: plan extraction, Local Enforcement Mode, Agent Identity, MCP Policy Proxy, policy enforcement, runtime budgets, Replay Diff, Evidence Export, and replayable observability. Open-source reference implementations, enterprise adoption guidance, and threat models aligned to OWASP LLM risks.</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="section-inner">
        <div class="section-kicker">Runtime Governance Model</div>
        <h2 class="section-h2">Four pillars for governed agentic AI.</h2>
        <p class="section-sub">AISecOps governs the runtime path from plan extraction to evidence export with security, compliance, cost control, and observability as first-class operating concerns.</p>

        <div class="layers-grid">
          <div class="layer-card">
            <div class="layer-card-head">
              <span class="layer-num-badge">L1</span>
              <span class="layer-card-title">Security</span>
            </div>
            <div class="layer-card-body">
              <p>Local Enforcement Mode, Agent Identity, capability validation, policy enforcement, and MCP Policy Proxy controls keep execution inside declared runtime boundaries.</p>
            </div>
          </div>
          <div class="layer-card">
            <div class="layer-card-head">
              <span class="layer-num-badge">L2</span>
              <span class="layer-card-title">Compliance</span>
            </div>
            <div class="layer-card-body">
              <p>Compliance Evidence Export, structured audit, Replay Diff review, and explicit governance results create an auditable record for regulated workflows.</p>
            </div>
          </div>
          <div class="layer-card">
            <div class="layer-card-head">
              <span class="layer-num-badge">L3</span>
              <span class="layer-card-title">Cost Control</span>
            </div>
            <div class="layer-card-body">
              <p>Runtime budgets, bounded agent activity, and policy-aware execution tracking keep agent behavior within spending limits.</p>
            </div>
          </div>
          <div class="layer-card">
            <div class="layer-card-head">
              <span class="layer-num-badge">L4</span>
              <span class="layer-card-title">Observability</span>
            </div>
            <div class="layer-card-body">
              <p>Replay Audit UI, execution graphs, Replay Diff, and Risk Explanation turn runtime events into operational visibility.</p>
            </div>
          </div>
        </div>

        <a class="btn-primary" href="/reference-architecture">View the Reference Architecture →</a>
      </div>
    </section>

    <section class="use-case-section">
      <div class="section-inner">
        <div class="section-kicker">Enterprise Use Cases</div>
        <h2 class="section-h2">Governance that fits the real workloads enterprises are putting in front of agents.</h2>
        <p class="section-sub">
          The pattern is the same across regulated and operational workflows: constrain action, record evidence, and keep a replayable trail for review.
        </p>

        <div class="use-case-grid">
          <div class="use-case-card">
            <div class="use-case-title">Banking agent</div>
            <div class="use-case-row"><strong>Risk:</strong> unauthorized transaction or policy-bypassing tool call</div>
            <div class="use-case-row"><strong>Control:</strong> capability validation + runtime budgets + approval</div>
            <div class="use-case-row"><strong>Artifact:</strong> Replay Diff + Evidence Export</div>
          </div>
          <div class="use-case-card">
            <div class="use-case-title">Healthcare agent</div>
            <div class="use-case-row"><strong>Risk:</strong> PHI exposure or unapproved record access</div>
            <div class="use-case-row"><strong>Control:</strong> Agent Identity + Local Enforcement Mode + policy enforcement</div>
            <div class="use-case-row"><strong>Artifact:</strong> structured audit events + compliance evidence</div>
          </div>
          <div class="use-case-card">
            <div class="use-case-title">Customer service agent</div>
            <div class="use-case-row"><strong>Risk:</strong> unauthorized refunds, account edits, or outbound abuse</div>
            <div class="use-case-row"><strong>Control:</strong> MCP Policy Proxy + capability gating + runtime budgets</div>
            <div class="use-case-row"><strong>Artifact:</strong> replay audit UI + approval trace</div>
          </div>
          <div class="use-case-card">
            <div class="use-case-title">Autonomous coding agent</div>
            <div class="use-case-row"><strong>Risk:</strong> destructive commands, secret leakage, or broken deployments</div>
            <div class="use-case-row"><strong>Control:</strong> plan extraction + local enforcement + runtime controls</div>
            <div class="use-case-row"><strong>Artifact:</strong> execution graphs + Replay Diff</div>
          </div>
        </div>
      </div>
    </section>

    <section class="runtime-section">
      <div class="section-inner">
        <div class="section-kicker">Runtime Investigation</div>
        <h2 class="section-h2">Replayable runtime forensics for governed agents.</h2>
        <p class="section-sub">
          AISecOps reconstructs execution history from structured runtime events:
          structured plan extraction, capability validation, policy enforcement, runtime budgets, runtime controls,
          execution, audit, Replay Diff, and final governance outcomes.
        </p>
        <div class="runtime-flow" aria-label="AISecOps runtime investigation flow">
          <div class="flow-step">
            <span class="flow-label">Agent</span>
          </div>
          <span class="flow-arrow">→</span>
          <div class="flow-step">
            <span class="flow-label">Plan</span>
          </div>
          <span class="flow-arrow">→</span>
          <div class="flow-step">
            <span class="flow-label">Capability</span>
          </div>
          <span class="flow-arrow">→</span>
          <div class="flow-step decision">
            <span class="flow-label">Policy</span>
          </div>
          <span class="flow-arrow">→</span>
          <div class="flow-step">
            <span class="flow-label">Runtime Controls</span>
          </div>
          <span class="flow-arrow">→</span>
          <div class="flow-step">
            <span class="flow-label">Execution</span>
          </div>
          <span class="flow-arrow">→</span>
          <div class="flow-step replay">
            <span class="flow-label">Audit</span>
          </div>
          <span class="flow-arrow">→</span>
          <div class="flow-step graph">
            <span class="flow-label">Replay Diff</span>
          </div>
          <span class="flow-arrow">→</span>
          <div class="flow-step graph">
            <span class="flow-label">Evidence</span>
          </div>
        </div>

        <div class="runtime-grid">
          <div class="runtime-row">
            <div class="runtime-copy">
              <div class="runtime-label">Replay Trace List</div>
              <h3 class="runtime-title">Investigate runtime decisions across traces.</h3>
              <p>
                Replay summaries expose runtime decisions, provenance trust levels,
                event counts, and execution outcomes for forensic investigation.
              </p>
            </div>
            <div class="runtime-image-wrap">
              <img
                class="runtime-image"
                src="/images/replay-ui-list.png"
                alt="AISecOps replay trace list"
                loading="lazy"
              />
            </div>
          </div>

          <div class="runtime-row reverse">
            <div class="runtime-copy">
              <div class="runtime-label">Timeline Reconstruction</div>
              <h3 class="runtime-title">Replay execution history step-by-step.</h3>
              <p>
                Structured replay timelines reconstruct planning, evaluation,
                approval, execution, and final governance decisions in execution order.
              </p>
            </div>
            <div class="runtime-image-wrap">
              <img
                class="runtime-image"
                src="/images/replay-ui-timeline.png"
                alt="AISecOps replay timeline"
                loading="lazy"
              />
            </div>
          </div>

          <div class="runtime-row">
            <div class="runtime-copy">
              <div class="runtime-label">Execution Graphs</div>
              <h3 class="runtime-title">Visualize provenance-aware execution flow.</h3>
              <p>
                Execution graphs reconstruct causal runtime relationships between
                provenance sources, planning stages, policy enforcement, approvals,
                tool execution, and final outcomes.
              </p>
            </div>
            <div class="runtime-image-wrap">
              <img
                class="runtime-image"
                src="/images/replay-ui-graph.png"
                alt="AISecOps execution graph"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <div class="runtime-actions">
          <a class="btn-primary" href="/runtime-forensics">Explore Runtime Forensics →</a>
        </div>
      </div>
    </section>

    <section class="featured-article-section">
      <div class="section-inner">
        <div class="featured-article-card">
          <div class="featured-article-copy">
            <div class="section-kicker">Featured Article</div>
            <h2 class="section-h2">I Built a Runtime Forensics Layer for AI Agents</h2>
            <p class="section-sub">
              A deep dive into AISecOps Interceptor, runtime governance, Replay Diff, Evidence Export,
              execution graphs, and why AI agents need a governance layer once they start taking actions.
            </p>
            <a
              class="btn-primary"
              href="https://medium.com/@viplav.fauzdar/i-built-a-runtime-forensics-layer-for-ai-agents-7e7c651cd758"
              target="_blank"
              rel="noopener noreferrer"
            >
              Read on Medium →
            </a>
          </div>
          <a
            class="featured-article-image-wrap"
            href="https://medium.com/@viplav.fauzdar/i-built-a-runtime-forensics-layer-for-ai-agents-7e7c651cd758"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Read the featured Medium article"
          >
            <img
              class="featured-article-image"
              src="/images/replay-ui-event-drawer.png"
              alt="AISecOps runtime forensics execution graph"
              loading="lazy"
            />
          </a>
        </div>
      </div>
    </section>

    <section>
      <div class="section-inner">
        <div class="section-kicker">Resources</div>
        <h2 class="section-h2">Everything is open and free.</h2>
        <p class="section-sub">Framework documentation, threat models, reference architecture, and working open-source code. No account required.</p>

        <div class="resources-grid">
          <a class="resource-card" href="/definition">
            <div class="resource-tag">Definition</div>
            <div class="resource-title">What Is AISecOps?</div>
            <p class="resource-desc">The disambiguation page — how AISecOps for agentic AI differs from legacy "AI for SecOps" definitions.</p>
            <span class="resource-link">Read the definition →</span>
          </a>
          <a class="resource-card" href="/threat-model">
            <div class="resource-tag">Threat Model</div>
            <div class="resource-title">Agentic AI Attack Surface</div>
            <p class="resource-desc">MCP, A2A, swarm systems — a structured threat model covering all major agentic AI attack vectors with OWASP LLM mapping.</p>
            <span class="resource-link">View threat model →</span>
          </a>
          <a class="resource-card" href="/reference-architecture">
            <div class="resource-tag">Architecture</div>
            <div class="resource-title">Reference Architecture</div>
              <p class="resource-desc">A runtime governance blueprint: Local Enforcement Mode, Agent Identity, capability validation, policy enforcement, runtime budgets, Replay Diff, and Evidence Export.</p>
            <span class="resource-link">View architecture →</span>
          </a>
          <a class="resource-card" href="/runtime-forensics">
            <div class="resource-tag">Runtime Forensics</div>
            <div class="resource-title">Replayable Audit and Provenance</div>
              <p class="resource-desc">Runtime investigation workflows for Agent Identity, Replay Diff, Compliance Evidence Export, timeline reconstruction, execution graph analysis, and forensic review of AI agent decisions.</p>
            <span class="resource-link">View runtime forensics →</span>
          </a>
          <a class="resource-card" href="/whitepaper">
            <div class="resource-tag">Whitepaper</div>
            <div class="resource-title">The AISecOps Framework</div>
              <p class="resource-desc">Framework document covering AISecOps v1.0 foundations, runtime governance, Replay Diff, Evidence Export, capability-gated execution, and enterprise adoption guidance.</p>
            <span class="resource-link">Download →</span>
          </a>
          <a class="resource-card" href="https://github.com/viplavfauzdar/aisecops-interceptor" target="_blank" rel="noopener noreferrer">
            <div class="resource-tag">Open Source</div>
            <div class="resource-title">aisecops-interceptor</div>
            <p class="resource-desc">Reference implementation with Runtime Governance APIs, Replay Diff Engine, Agent Identity Layer, Replay Audit UI, and execution graph investigation.</p>
            <span class="resource-link">View on GitHub →</span>
          </a>
          <!--<a class="resource-card" href="https://github.com/viplavfauzdar/aisecops-openclaw-plugin" target="_blank" rel="noopener noreferrer">
            <div class="resource-tag">Open Source</div>
            <div class="resource-title">OpenClaw Plugin</div>
            <p class="resource-desc">Enterprise adapter for routing OpenClaw execution plans through the AISecOps runtime control plane with capability validation, policy enforcement, and structured audit events.</p>
            <span class="resource-link">View on GitHub →</span>-->
          </a>
        </div>
      </div>
    </section>

    <section class="founder-section">
      <div class="section-inner">
        <div class="founder-card">
          <div class="founder-avatar" aria-hidden="true">VF</div>
          <div class="founder-copy">
            <div class="section-kicker">Meet the Creator</div>
            <h2 class="section-h2">Viplav Fauzdar built AISecOps Interceptor as a runtime governance reference implementation.</h2>
            <p class="section-sub">
              Viplav Fauzdar is a senior software engineer and AI architecture practitioner with 25+ years of enterprise engineering experience across backend systems, cloud platforms, distributed systems, and AI-enabled software. He created AISecOps Interceptor as an open-source reference implementation for governing agentic AI systems at runtime.
            </p>
            <div class="founder-links">
              <a href="https://github.com/viplavfauzdar" target="_blank" rel="noopener noreferrer">GitHub</a>
              <a href="https://linkedin.com/in/viplavfauzdar" target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a href="https://medium.com/@viplav.fauzdar" target="_blank" rel="noopener noreferrer">Medium</a>
              <a href="https://viplavfauzdar.com" target="_blank" rel="noopener noreferrer">Portfolio</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="demo-cta-section">
      <div class="section-inner">
        <div class="demo-cta-card">
          <div class="section-kicker">Live Demo Coming Soon</div>
          <h2 class="section-h2">Try a simulated agent attack and see AISecOps block, replay, diff, and export evidence.</h2>
          <p class="section-sub">
            The live demo is being prepared. For now, the /demo page shows the planned attack scenarios and the governance flow behind the experience.
          </p>
          <div class="demo-cta-actions">
            <a class="btn-primary" href="/demo">Open Demo Placeholder →</a>
            <a class="btn-secondary" href="https://github.com/viplavfauzdar/aisecops-interceptor" target="_blank" rel="noopener noreferrer">View GitHub</a>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --ink: #0d1117;
    --paper: #f8f6f1;
    --accent: #c94f1e;
    --accent2: #1a4f8a;
    --muted: #6b6460;
    --rule: #ddd9d3;
    --serif: "DM Serif Display", Georgia, serif;
    --mono: "IBM Plex Mono", monospace;
    --sans: "Instrument Sans", sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }


  .hero {
    min-height: 88vh;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--rule);
    padding: 4rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 60% at 80% 40%, rgba(201, 79, 30, 0.06) 0%, transparent 70%),
      radial-gradient(ellipse 40% 50% at 20% 70%, rgba(26, 79, 138, 0.05) 0%, transparent 70%);
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .hero-inner {
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 4rem;
    align-items: center;
  }

  .hero-kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    animation: fadeUp 0.5s ease both;
  }

  .hero-kicker::before {
    content: "";
    display: block;
    width: 24px;
    height: 1px;
    background: var(--accent);
  }

  .hero-h1 {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin-bottom: 1.6rem;
    animation: fadeUp 0.5s 0.1s ease both;
  }

  .hero-h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-p {
    font-size: 1.1rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: 2.5rem;
    animation: fadeUp 0.5s 0.2s ease both;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    animation: fadeUp 0.5s 0.3s ease both;
  }

  .release-badge {
    display: inline-flex;
    align-items: center;
    margin-top: 1.1rem;
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    animation: fadeUp 0.5s 0.4s ease both;
  }

  .btn-primary {
    background: var(--ink);
    color: white;
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.75rem 1.5rem;
    border-radius: 3px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--accent);
  }

  .btn-secondary {
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.75rem 1.5rem;
    border-radius: 3px;
    text-decoration: none;
    transition: border-color 0.2s;
    background: white;
  }

  .btn-secondary:hover {
    border-color: var(--ink);
  }

  .architecture-card {
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.1);
    animation: fadeUp 0.6s 0.35s ease both;
    backdrop-filter: blur(4px);
  }

  .architecture-head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }

  .architecture-kicker {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .architecture-headline {
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--ink);
  }

  .architecture-flow {
    display: grid;
    gap: 0.55rem;
  }

  .arch-step {
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: #fff;
    padding: 0.85rem 1rem;
  }

  .arch-highlight {
    border-color: rgba(201, 79, 30, 0.3);
    background: #fff7f0;
  }

  .arch-step-label {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .arch-highlight .arch-step-label {
    color: var(--accent);
  }

  .arch-step-sub {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .arch-arrow {
    display: grid;
    place-items: center;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.9rem;
    line-height: 1;
  }

  .architecture-foot {
    margin-top: 0.9rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .runtime-proof-section {
    background: #fbfaf7;
  }

  .terminal {
    background: #0d1117;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.18);
    border: 1px solid #1a1f2e;
  }

  .terminal-bar {
    background: #1a1f2e;
    padding: 0.7rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-r {
    background: #ff5f57;
  }

  .dot-y {
    background: #febc2e;
  }

  .dot-g {
    background: #28c840;
  }

  .terminal-title {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: #7b8794;
    margin-left: 0.5rem;
    letter-spacing: 0.04em;
  }

  .terminal-body {
    padding: 1.15rem 1.25rem 1.2rem;
    font-family: var(--mono);
    display: grid;
    gap: 0.45rem;
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .terminal-line {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .terminal-line .t-key {
    color: #7ecfb3;
  }

  .trust-bar {
    background: white;
    border-bottom: 1px solid var(--rule);
    padding: 1rem 2rem;
  }

  .trust-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .trust-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .trust-items {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .trust-item {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .trust-item::before {
    content: "✓";
    color: var(--accent);
    font-weight: bold;
  }

  .comparison-section {
    background: #fcfbf8;
  }

  .comparison-wrap {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: white;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 760px;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 0.95rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    font-size: 0.92rem;
  }

  .comparison-table th {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: #fbfaf7;
  }

  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .aisecops-col {
    color: var(--accent);
  }

  .score {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.8rem;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .score.strong {
    background: #fff1e7;
    color: var(--accent);
  }

  .score.partial {
    background: #f2f4f7;
    color: #5a6472;
  }

  .score.weak {
    background: #f6f3ef;
    color: #8c847b;
  }

  .use-case-section {
    background: white;
  }

  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .use-case-card {
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: #fff;
    padding: 1.1rem 1.15rem;
  }

  .use-case-title {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .use-case-row {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
    margin-bottom: 0.45rem;
  }

  .use-case-row strong {
    color: var(--ink);
  }

  section {
    padding: 5rem 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .section-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .section-kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }

  .section-h2 {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .section-sub {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 580px;
    line-height: 1.65;
    margin-bottom: 3rem;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 3rem;
  }

  .problem-cell {
    background: white;
    padding: 1.8rem;
  }

  .problem-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }

  .problem-label.before {
    color: var(--muted);
  }

  .problem-label.after {
    color: var(--accent);
  }

  .problem-cell p {
    font-size: 0.92rem;
    color: #333;
    line-height: 1.6;
    margin: 0;
  }

  .layers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .layer-card {
    background: white;
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }

  .layer-card:hover {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }

  .layer-card-head {
    padding: 0.7rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .layer-num-badge {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: white;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.04em;
  }

  .layer-card-title {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .layer-card-body {
    padding: 0 1.1rem 1.1rem;
  }

  .layer-card-body p {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }

  .layer-card:nth-child(1) .layer-card-head {
    background: #fdf4f0;
  }

  .layer-card:nth-child(1) .layer-num-badge {
    background: #c94f1e;
  }

  .layer-card:nth-child(2) .layer-card-head {
    background: #f0f5fc;
  }

  .layer-card:nth-child(2) .layer-num-badge {
    background: #1a4f8a;
  }

  .layer-card:nth-child(3) .layer-card-head {
    background: #f0f8f4;
  }

  .layer-card:nth-child(3) .layer-num-badge {
    background: #1a6e4f;
  }

  .layer-card:nth-child(4) .layer-card-head {
    background: #f5f0fc;
  }

  .layer-card:nth-child(4) .layer-num-badge {
    background: #5a3e8a;
  }

  .runtime-section {
    background: #fcfbf8;
  }

  .runtime-flow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: -1rem 0 4rem;
    padding: 1rem;
    background: white;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .flow-step {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: #f8f6f1;
    color: var(--ink);
  }

  .flow-step.decision {
    border-color: rgba(201, 79, 30, 0.35);
    background: #fdf4f0;
    color: var(--accent);
  }

  .flow-step.replay,
  .flow-step.graph {
    border-color: rgba(26, 79, 138, 0.28);
    background: #f0f5fc;
    color: var(--accent2);
  }

  .flow-arrow {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .runtime-grid {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .runtime-row {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 2rem;
    align-items: center;
  }

  .runtime-row.reverse {
    grid-template-columns: 1fr 320px;
  }

  .runtime-row.reverse .runtime-copy {
    order: 2;
  }

  .runtime-row.reverse .runtime-image-wrap {
    order: 1;
  }

  .runtime-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }

  .runtime-title {
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1.25;
    margin-bottom: 0.8rem;
    font-weight: 400;
  }

  .runtime-copy p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .runtime-image-wrap {
    border: 1px solid var(--rule);
    border-radius: 10px;
    overflow: hidden;
    background: #0d1117;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.12);
  }

  .runtime-image {
    width: 100%;
    display: block;
  }

  .runtime-actions {
    margin-top: 4rem;
    display: flex;
    justify-content: center;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
  }

  .resource-card {
    background: white;
    padding: 1.8rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
    display: block;
  }

  .resource-card:hover {
    background: #fdfbf8;
  }

  .resource-tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }

  .resource-title {
    font-family: var(--serif);
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .resource-desc {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }

  .resource-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.03em;
  }

  .email-section {
    background: var(--ink);
    color: white;
    padding: 5rem 2rem;
    border-bottom: 1px solid #1a1f2e;
  }

  .email-inner {
    max-width: 580px;
    margin: 0 auto;
    text-align: center;
  }

  .email-kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: #7ecfb3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .email-h2 {
    font-family: var(--serif);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 0.8rem;
  }

  .email-sub {
    font-size: 0.95rem;
    color: #888;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .email-form {
    display: flex;
    gap: 0.7rem;
    max-width: 420px;
    margin: 0 auto;
  }

  .email-form input {
    flex: 1;
    background: #1a1f2e;
    border: 1px solid #2a3040;
    color: white;
    font-family: var(--sans);
    font-size: 0.9rem;
    padding: 0.75rem 1rem;
    border-radius: 3px;
    outline: none;
    transition: border-color 0.2s;
  }

  .email-form input::placeholder {
    color: #555;
  }

  .email-form input:focus {
    border-color: #7ecfb3;
  }

  .email-form button {
    background: var(--accent);
    color: white;
    border: none;
    cursor: pointer;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.75rem 1.2rem;
    border-radius: 3px;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .email-form button:hover {
    background: #a83d12;
  }

  .email-note {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: #555;
    letter-spacing: 0.04em;
    margin-top: 1rem;
  }


  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .featured-article-section {
    background: #f8f6f1;
  }

  .founder-section {
    background: #fbfaf7;
  }

  .founder-card {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1.5rem;
    align-items: center;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: white;
    padding: 1.5rem;
  }

  .founder-avatar {
    width: 180px;
    height: 180px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background:
      linear-gradient(180deg, rgba(201, 79, 30, 0.12), rgba(201, 79, 30, 0.04)),
      #fff;
    border: 1px solid rgba(201, 79, 30, 0.24);
    color: var(--accent);
    font-family: var(--serif);
    font-size: 3.6rem;
    line-height: 1;
  }

  .founder-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    margin-top: 1rem;
  }

  .founder-links a {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .demo-cta-section {
    background: #f8f6f1;
  }

  .demo-cta-card {
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: white;
    padding: 1.75rem;
  }

  .demo-cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .featured-article-card {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 2rem;
    align-items: center;
    background: white;
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 2rem;
    overflow: hidden;
  }

