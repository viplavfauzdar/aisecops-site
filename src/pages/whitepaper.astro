---
import ProseLayout from "../layouts/ProseLayout.astro";
import { getCollection } from "astro:content";
const title = "AISecOps v1.0 Whitepaper";
const description = "Read the AISecOps v1.0 whitepaper web edition and download the current PDF draft.";
const whitepapers = await getCollection("whitepapers");
const whitepaper = whitepapers.find((entry) => entry.data.version === "1.0.0" || entry.data.title === "AISecOps v1.0");
if (!whitepaper) {
  throw new Error("Missing whitepaper entry: src/content/whitepapers/aisecops.md");
}
const { Content } = await whitepaper.render();
---
<ProseLayout title={title} description={description}>
  <Content />
  <p class="mt-8">The web edition reflects AISecOps v1.0. The downloadable PDF is the current whitepaper edition.</p>
  <div class="not-prose actions">
    <a href="/pdfs/aisecops-whitepaper.pdf" class="btn-primary" download>Download PDF</a>
    <a href="/reference-architecture" class="btn-secondary">See Architecture</a>
  </div>
</ProseLayout>

<style>
  .actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: 0.7rem 1.2rem;
    border-radius: 3px;
  }

  .btn-primary {
    background: var(--ink);
    color: #fff;
  }

  .btn-primary:hover { background: var(--accent); }

  .btn-secondary {
    border: 1px solid var(--rule);
    background: #fff;
    color: var(--ink);
  }

  .btn-secondary:hover { border-color: var(--ink); }

</style>
