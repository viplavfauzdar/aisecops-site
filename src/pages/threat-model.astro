---
import ProseLayout from "../layouts/ProseLayout.astro";
import ThreatModelContent from "../content/threatmodel.md";

const title = "AISecOps Threat Model - Agentic AI Attack Surface & Runtime Controls | aisecops.net";
const description = "A structured threat model for agentic AI systems: prompt injection via RAG, tool execution abuse, missing agent identity, missing replay diff, missing evidence export, uncontrolled runtime cost, MCP abuse, and governance failure.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "AISecOps Threat Model for Agentic AI",
  description,
  author: {
    "@type": "Person",
    name: "Viplav Fauzdar",
    url: "https://medium.com/@viplav.fauzdar"
  },
  publisher: {
    "@type": "Organization",
    name: "AISecOps",
    url: "https://aisecops.net"
  },
  dateModified: "2026-05-19",
  mainEntityOfPage: "https://aisecops.net/threat-model"
};
---
<ProseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="threat-hero not-prose">
    <div class="hero-copy">
      <div class="eyebrow">Threat Model</div>
      <h1>AISecOps Threat Model for Agentic AI</h1>
      <p class="subtitle">
        A structured threat model covering prompt injection, tool abuse, MCP attacks, runtime governance failures,
        compliance gaps, and operational risk.
      </p>
      <p class="reference">
        <strong>Current OSS reference:</strong> AISecOps Interceptor v1.0.0 - Replay Diff Engine, Agent Identity Layer,
        and Evidence Export.
      </p>
      <div class="summary-grid" aria-label="AISecOps governance pillars">
        <div class="summary-card">
          <div class="summary-label">Security</div>
          <p>Protect agent identity, tool access, policy enforcement, and runtime boundaries.</p>
        </div>
        <div class="summary-card">
          <div class="summary-label">Compliance</div>
          <p>Export evidence, preserve audit trails, and support regulated review workflows.</p>
        </div>
        <div class="summary-card">
          <div class="summary-label">Cost Control</div>
          <p>Track runtime budgets, limit execution drift, and surface spend anomalies early.</p>
        </div>
        <div class="summary-card">
          <div class="summary-label">Observability</div>
          <p>Use replay diff, execution graphs, and risk explanation to understand what changed.</p>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="diagram-shell">
        <div class="diagram-title">Runtime threat flow</div>
        <div class="mermaid threat-diagram">
flowchart LR
  I[Inputs]
  P[Planning]
  G[Governance]
  E[Execution]
  F[Forensics]

  I --> P --> G --> E --> F

  subgraph B[Governance boundaries]
    direction TB
    B1[Prompt Injection]
    B2[Capability Escalation]
    B3[MCP Abuse]
    B4[Runtime Cost Explosion]
    B5[Approval Bypass]
    B6[Governance Failure]
  end

  I -.-> B1
  P -.-> B2
  G -.-> B3
  G -.-> B4
  E -.-> B5
  F -.-> B6
        </div>
      </div>

      <div class="boundary-list" aria-label="Governance boundaries">
        <span>Prompt Injection</span>
        <span>Capability Escalation</span>
        <span>MCP Abuse</span>
        <span>Runtime Cost Explosion</span>
        <span>Approval Bypass</span>
        <span>Governance Failure</span>
      </div>
    </div>
  </section>

  <ThreatModelContent />
</ProseLayout>

<style>
  .threat-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1.5rem;
    align-items: start;
    padding: 2.5rem 0 1.75rem;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .hero-copy h1 {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 0.9rem;
  }

  .subtitle {
    font-size: 1.08rem;
    color: var(--muted);
    max-width: 44rem;
    margin: 0 0 1rem;
  }

  .reference {
    font-size: 0.92rem;
    color: var(--ink);
    margin: 0 0 1.25rem;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .summary-card {
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: #fff;
    padding: 0.95rem 1rem;
  }

  .summary-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }

  .summary-card p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #2a2a2a;
  }

  .hero-visual {
    display: grid;
    gap: 0.85rem;
  }

  .diagram-shell {
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: #fff;
    padding: 1rem;
  }

  .diagram-title {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.8rem;
  }

  .threat-diagram {
    min-height: 360px;
  }

  .boundary-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .boundary-list span {
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: #fff;
    padding: 0.45rem 0.7rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .threat-hero {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .summary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
