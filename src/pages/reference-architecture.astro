---
import ProseLayout from "../layouts/ProseLayout.astro";
import ArchitectureContent from "../content/architecture.md";

const title = "AISecOps Reference Architecture - Runtime Governance Platform for Agentic AI | aisecops.net";
const description = "AISecOps reference architecture for runtime governance: agent runtime, plan extraction, capability validation, policy enforcement, runtime budgets, runtime controls, execution, audit events, replay engine, replay diff, and evidence export.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "AISecOps Reference Architecture - Runtime Governance Platform for Agentic AI",
  description,
  author: {
    "@type": "Person",
    name: "Viplav Fauzdar",
    url: "https://medium.com/@viplav.fauzdar"
  },
  publisher: {
    "@type": "Organization",
    name: "AISecOps",
    url: "https://aisecops.net"
  },
  dateModified: "2026-05-19",
  mainEntityOfPage: "https://aisecops.net/reference-architecture"
};
---
<ProseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="not-prose diagram-wrap">
    <img src="/architecture.svg" alt="AISecOps Reference Architecture Diagram" class="w-full h-auto" />
    <div class="diagram-note">
      AISecOps Interceptor v1.0.0 reference architecture with local enforcement mode,
      MCP policy proxy, agent identity layer, structured plan extraction,
      policy enforcement, runtime budgets, replay diff, and evidence export.
    </div>
  </div>
  <p><strong>Current OSS reference:</strong> AISecOps Interceptor v1.0.0 - Replay Diff Engine + Evidence Export.</p>
  <p>
    The current architecture adds agent identity, local enforcement mode, MCP policy proxy, replay diff,
    compliance evidence export, and runtime governance APIs so runtime decisions can be reviewed after the fact
    instead of only logged.
  </p>
  <ArchitectureContent />
</ProseLayout>

<style>
  .diagram-wrap {
    margin-top: 2rem;
    border-radius: 8px;
    border: 1px solid var(--rule);
    background: #fff;
    padding: 1.25rem;
  }

  .diagram-note {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
