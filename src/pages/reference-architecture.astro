---
import ProseLayout from "../layouts/ProseLayout.astro";
import ArchitectureContent from "../content/architecture.md";

const title = "AISecOps Reference Architecture";
const description = "AISecOps Interceptor v0.7.0 reference architecture: context controls, capability-gated execution, structured JSONL audit events, replay APIs, Replay Audit UI, execution graph reconstruction, and runtime forensics.";
---
<ProseLayout title={title} description={description}>
  <div class="not-prose diagram-wrap">
    <img src="/architecture.svg" alt="AISecOps Reference Architecture Diagram" class="w-full h-auto" />
    <div class="diagram-note">
      AISecOps Interceptor v0.7.0 reference architecture with local enforcement,
      capability-gated execution, explicit plan/evaluate/execute separation,
      structured JSONL audit events, replay APIs, and runtime investigation surfaces.
    </div>
  </div>
  <p><strong>Current OSS reference:</strong> AISecOps Interceptor v0.7.0 — Replay Audit UI + Execution Graphs.</p>
  <p>
    In addition to execution governance, the current architecture now includes Replay APIs, the Replay Audit UI,
    and execution graph reconstruction so runtime decisions can be investigated after the fact instead of only logged.
  </p>
  <ArchitectureContent />
</ProseLayout>

<style>
  .diagram-wrap {
    margin-top: 2rem;
    border-radius: 8px;
    border: 1px solid var(--rule);
    background: #fff;
    padding: 1.25rem;
  }

  .diagram-note {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
